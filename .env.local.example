# 本地开发环境配置
# 复制此文件为 .env.local 并根据需要填入实际值

# ============================================
# API 配置（必填）
# ============================================
# 后端API地址（阿里云边缘函数地址）
VITE_API_BASE=https://localhost:3000

# ============================================
# OAuth 配置（可选 - 不填则只使用游客模式）
# ============================================

# GitHub OAuth（可选）
# 申请地址: https://github.com/settings/developers
# VITE_GITHUB_CLIENT_ID=your_github_client_id_here
# VITE_GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback

# Microsoft OAuth（可选）
# 申请地址: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
# VITE_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
# VITE_MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/callback

# ============================================
# 使用说明
# ============================================
# 1. 只想本地测试：不填OAuth配置，使用游客模式即可
# 2. 需要个人账号：配置对应的OAuth Client ID
# 3. 生产环境：需要配置所有OAuth并修改API_BASE
